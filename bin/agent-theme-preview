#!/usr/bin/env bash
# Deterministic review boards for Omarchy theme palettes and wallpaper filters.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  agent-theme-preview wallpaper [--gap PX] <colors.toml> <output.png> <level-1.png> [level-2.png ...]
  agent-theme-preview palette [--title TEXT] [--size WIDTHxHEIGHT] <colors.toml> <output.png>
  agent-theme-preview picker [--title TEXT] [--subtitle TEXT] [--top-offset PX]
                             [--closeup IMAGE:WxH+X+Y]
                             <colors.toml> <top-image> <output.png>

wallpaper
  Composites one or more same-framing filter levels into contiguous diagonal
  regions (one level is shown whole). The limit is width: each region keeps
  at least 48px of image between gaps.
  Each image contributes only its true spatial area; blank gutters and
  Omarchy-style palette borders make the treatment progression unambiguous.

palette
  Draws a standard, role-based palette card. Every swatch includes its color
  key and hexadecimal value. It defaults to a 640x694 half-workspace tile.

picker
  Draws a 1920x1080 Omarchy theme-picker tile: an 820px top image and a
  palette band with a close-up, title, swatches, and type sample. --top-offset
  selects the vertical crop after the top image is resized to 1920px wide.
  --closeup uses a source image and crop geometry; without it, the top image's
  centered crop is used.
EOF
}

need_image() {
  [[ -f $1 ]] || { echo "agent-theme-preview: missing image: $1" >&2; exit 2; }
  [[ $(file --brief --mime-type -- "$1") == image/* ]] || {
    echo "agent-theme-preview: not an image: $1" >&2
    exit 2
  }
}

toml_color() {
  local key="$1" colors="$2" value
  value=$(sed -nE "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\\\"(#[0-9A-Fa-f]{6})\\\"[[:space:]]*(#.*)?$/\\1/p" "$colors" | head -n 1)
  [[ -n $value ]] || { echo "agent-theme-preview: colors.toml lacks '$key'" >&2; exit 2; }
  printf '%s\n' "$value"
}

luminance_of() {
  local hex="$1"
  printf '%s\n' $(((2126 * 16#${hex:1:2} + 7152 * 16#${hex:3:2} + 722 * 16#${hex:5:2}) / 10000))
}

# Label color for a swatch: the darker of the two candidates on a light swatch,
# the lighter on a dark one. Candidates are ordered by luminance rather than by
# role, so light themes (where dark_background is light) label legibly too.
text_on() {
  local hex="$1" dark="$2" light="$3"
  if (( $(luminance_of "$dark") > $(luminance_of "$light") )); then
    dark="$3" light="$2"
  fi
  if (( $(luminance_of "$hex") > 148 )); then
    printf '%s\n' "$dark"
  else
    printf '%s\n' "$light"
  fi
}

render_wallpaper() {
  local gap=24
  if [[ ${1:-} == --gap ]]; then
    gap="${2:-}"
    shift 2
  fi
  [[ $gap =~ ^[0-9]+$ ]] || { echo 'agent-theme-preview: --gap must be a positive integer' >&2; exit 2; }
  (( $# >= 3 )) || { usage >&2; exit 2; }

  local colors="$1" output="$2"
  shift 2
  local -a levels=("$@")
  local n=${#levels[@]}
  [[ -f $colors ]] || { echo "agent-theme-preview: missing colors file: $colors" >&2; exit 2; }
  local image
  for image in "${levels[@]}"; do need_image "$image"; done

  local width height geometry base inactive fg darkfg accent orange yellow muted cyan magenta
  geometry=$(magick identify -format '%w %h' "${levels[0]}")
  read -r width height <<<"$geometry"
  (( width > 0 && height > 0 )) || { echo 'agent-theme-preview: unreadable image geometry' >&2; exit 2; }
  # Any number of levels works until a region would be too thin to judge: each
  # needs at least 48px of image between its gaps (strokes eat ~11px of that).
  local max_levels=$((width / (gap + 48)))
  (( n <= max_levels )) || {
    echo "agent-theme-preview: $n levels leave regions too thin at ${width}px wide with --gap $gap (max $max_levels)" >&2
    exit 2
  }
  base=$(toml_color darker_background "$colors")
  inactive=$(toml_color hyprland_inactive_border "$colors")
  fg=$(toml_color bright_foreground "$colors")
  darkfg=$(toml_color dark_background "$colors")
  accent=$(toml_color accent "$colors")
  orange=$(toml_color orange "$colors")
  yellow=$(toml_color yellow "$colors")
  muted=$(toml_color muted "$colors")
  cyan=$(toml_color cyan "$colors")
  magenta=$(toml_color magenta "$colors")
  local -a border_colors=("$accent" "$orange" "$yellow" "$muted" "$cyan" "$magenta")

  local work
  work=$(mktemp -d /tmp/agent-theme-preview-XXXXXX)
  trap 'rm -rf "$work"' RETURN
  magick -size "${width}x${height}" "xc:${base}" "$work/canvas.png"

  local slant=$((width / (n * 4)))
  local half_gap=$((gap / 2))
  local i left_top left_bottom right_top right_bottom top bottom polygon mask panel color
  local -a edge_top=() edge_bottom=()
  for ((i = 1; i < n; i++)); do
    edge_top[i]=$((i * width / n + slant / 2))
    edge_bottom[i]=$((edge_top[i] - slant))
  done

  for ((i = 0; i < n; i++)); do
    if (( i == 0 )); then
      left_top=0; left_bottom=0
    else
      left_top=$((edge_top[i] + half_gap))
      left_bottom=$((edge_bottom[i] + half_gap))
    fi
    if (( i == n - 1 )); then
      right_top=$width; right_bottom=$width
    else
      right_top=$((edge_top[i + 1] - half_gap))
      right_bottom=$((edge_bottom[i + 1] - half_gap))
    fi
    polygon="${left_top},0 ${right_top},0 ${right_bottom},${height} ${left_bottom},${height}"
    mask="$work/mask-$i.png"
    panel="$work/panel-$i.png"
    magick -size "${width}x${height}" xc:black -fill white -draw "polygon ${polygon}" "$mask"
    magick "${levels[i]}" -resize "${width}x${height}!" "$mask" -alpha off -compose CopyOpacity -composite "$panel"
    magick "$work/canvas.png" "$panel" -compose over -composite "$work/next.png"
    mv "$work/next.png" "$work/canvas.png"

    # A deep inactive outline plus a bright palette edge echoes Omarchy's
    # inactive/active window-border treatment around every filter region.
    color="${border_colors[i % ${#border_colors[@]}]}"
    magick "$work/canvas.png" -fill none -stroke "$inactive" -strokewidth 8 -draw "polygon ${polygon}" \
      -stroke "$color" -strokewidth 3 -draw "polygon ${polygon}" "$work/next.png"
    mv "$work/next.png" "$work/canvas.png"
  done

  # Fixed zlib level, filter and strategy with no metadata: identical inputs
  # give byte-identical PNGs on this machine, at a fraction of the size of an
  # uncompressed one.
  magick "$work/canvas.png" -strip -define png:exclude-chunk=date,time \
    -define png:compression-level=9 -define png:compression-filter=5 -define png:compression-strategy=1 "PNG24:${output}"
  trap - RETURN
  rm -rf "$work"
  printf 'Rendered wallpaper review board: %s\n' "$output"
}

render_palette() {
  local title='OMARCHY PALETTE'
  local size='640x694'
  while (( $# > 0 )); do
    case "$1" in
      --title) title="${2:?agent-theme-preview: --title needs text}"; shift 2 ;;
      --size) size="${2:?agent-theme-preview: --size needs WIDTHxHEIGHT}"; shift 2 ;;
      *) break ;;
    esac
  done
  (( $# == 2 )) || { usage >&2; exit 2; }
  local colors="$1" output="$2"
  [[ -f $colors ]] || { echo "agent-theme-preview: missing colors file: $colors" >&2; exit 2; }
  [[ $size =~ ^([1-9][0-9]*)x([1-9][0-9]*)$ ]] || {
    echo 'agent-theme-preview: --size must be WIDTHxHEIGHT' >&2
    exit 2
  }
  local width="${BASH_REMATCH[1]}" height="${BASH_REMATCH[2]}"

  local background dark_background lighter_background foreground bright_foreground inactive accent selection
  background=$(toml_color background "$colors")
  dark_background=$(toml_color dark_background "$colors")
  lighter_background=$(toml_color lighter_background "$colors")
  foreground=$(toml_color foreground "$colors")
  bright_foreground=$(toml_color bright_foreground "$colors")
  inactive=$(toml_color hyprland_inactive_border "$colors")
  accent=$(toml_color accent "$colors")
  selection=$(toml_color selection "$colors")

  local -a keys=(background dark_background lighter_background foreground accent selection red orange yellow green cyan blue magenta brown)
  local font
  font=$(fc-match -f '%{file}\n' 'sans-serif' | head -n 1)
  local columns=2 rows=7 margin_x=$((width / 32)) margin_y=$((height / 30)) card_gap=$((width / 54)) bottom_margin=$((height / 38))
  (( margin_x < 20 )) && margin_x=20
  (( margin_y < 18 )) && margin_y=18
  (( card_gap < 10 )) && card_gap=10
  (( bottom_margin < 16 )) && bottom_margin=16
  local title_size=$((width / 25)) subtitle_size=$((width / 58)) label_size=$((width / 48)) hex_size=$((width / 64))
  (( title_size < 20 )) && title_size=20
  (( subtitle_size < 10 )) && subtitle_size=10
  (( label_size < 13 )) && label_size=13
  (( hex_size < 10 )) && hex_size=10
  local cards_top=$((margin_y + title_size + subtitle_size + 34))
  local card_width=$(((width - 2 * margin_x - card_gap) / columns))
  local card_height=$(((height - cards_top - bottom_margin - (rows - 1) * card_gap) / rows))
  (( card_height >= 54 )) || { echo 'agent-theme-preview: requested palette size is too short' >&2; exit 2; }

  local -a command=(magick -size "${width}x${height}" "xc:${background}" -font "$font" -fill "$bright_foreground" -pointsize "$title_size" -gravity NorthWest -annotate "+${margin_x}+${margin_y}" "$title" -fill "$foreground" -pointsize "$subtitle_size" -annotate "+${margin_x}+$((margin_y + title_size + 14))" 'theme palette · roles · hex in every swatch')
  local key hex x y column row label_color shadow_radius radius label_y hex_y
  shadow_radius=$((card_height / 7)); (( shadow_radius < 8 )) && shadow_radius=8
  radius=$((card_height / 8)); (( radius < 7 )) && radius=7
  for ((i = 0; i < ${#keys[@]}; i++)); do
    key="${keys[i]}"
    hex=$(toml_color "$key" "$colors")
    column=$((i % columns)); row=$((i / columns))
    x=$((margin_x + column * (card_width + card_gap)))
    y=$((cards_top + row * (card_height + card_gap)))
    label_color=$(text_on "$hex" "$dark_background" "$bright_foreground")
    label_y=$((y + card_height / 5))
    hex_y=$((y + card_height / 2 + 3))
    command+=( -fill "$inactive" -stroke none -draw "roundrectangle $((x - 3)),$((y - 3)),$((x + card_width + 3)),$((y + card_height + 3)),${shadow_radius},${shadow_radius}" )
    command+=( -fill "$hex" -stroke "$accent" -strokewidth 2 -draw "roundrectangle ${x},${y},$((x + card_width)),$((y + card_height)),${radius},${radius}" )
    command+=( -fill "$label_color" -stroke none -pointsize "$label_size" -gravity NorthWest -annotate "+$((x + 13))+${label_y}" "$key" )
    command+=( -fill "$label_color" -stroke none -pointsize "$hex_size" -gravity NorthWest -annotate "+$((x + 13))+${hex_y}" "${hex,,}" )
  done
  "${command[@]}" -strip -define png:exclude-chunk=date,time \
    -define png:compression-level=9 -define png:compression-filter=5 -define png:compression-strategy=1 "PNG24:${output}"
  printf 'Rendered palette review board: %s\n' "$output"
}

render_picker() {
  local title='OMARCHY THEME' subtitle='' top_offset=0 closeup_spec=''
  while (( $# > 0 )); do
    case "$1" in
      --title) title="${2:?agent-theme-preview: --title needs text}"; shift 2 ;;
      --subtitle) subtitle="${2:?agent-theme-preview: --subtitle needs text}"; shift 2 ;;
      --top-offset) top_offset="${2:?agent-theme-preview: --top-offset needs pixels}"; shift 2 ;;
      --closeup) closeup_spec="${2:?agent-theme-preview: --closeup needs IMAGE:WxH+X+Y}"; shift 2 ;;
      *) break ;;
    esac
  done
  (( $# == 3 )) || { usage >&2; exit 2; }
  local colors="$1" top_image="$2" output="$3"
  [[ -f $colors ]] || { echo "agent-theme-preview: missing colors file: $colors" >&2; exit 2; }
  need_image "$top_image"
  [[ $top_offset =~ ^[0-9]+$ ]] || { echo 'agent-theme-preview: --top-offset must be a non-negative integer' >&2; exit 2; }

  local closeup_image="$top_image" closeup_crop=''
  if [[ -n $closeup_spec ]]; then
    if [[ $closeup_spec =~ ^(.+):([1-9][0-9]*x[1-9][0-9]*\+[0-9]+\+[0-9]+)$ ]]; then
      closeup_image="${BASH_REMATCH[1]}"
      closeup_crop="${BASH_REMATCH[2]}"
    else
      echo 'agent-theme-preview: --closeup must be IMAGE:WxH+X+Y' >&2
      exit 2
    fi
    need_image "$closeup_image"
  fi

  local scaled_height
  scaled_height=$(magick identify -format '%w %h' "$top_image" | awk '{ printf "%d", $2 * 1920 / $1 + 0.5 }')
  (( scaled_height >= top_offset + 820 )) || {
    echo "agent-theme-preview: --top-offset ${top_offset} leaves less than 820px after resizing the top image to 1920px wide" >&2
    exit 2
  }

  local background foreground dark_foreground accent selection key
  background=$(toml_color background "$colors")
  foreground=$(toml_color foreground "$colors")
  dark_foreground=$(toml_color dark_foreground "$colors")
  accent=$(toml_color accent "$colors")
  selection=$(toml_color selection "$colors")
  local -a chip_keys=(accent red orange yellow green cyan blue magenta)
  local -a chips=()
  for key in "${chip_keys[@]}"; do
    chips+=( \( -size 100x100 "xc:$(toml_color "$key" "$colors")" \) )
  done

  local regular='/usr/share/fonts/liberation/LiberationSans-Regular.ttf'
  local bold='/usr/share/fonts/liberation/LiberationSans-Bold.ttf'
  [[ -f $regular && -f $bold ]] || {
    echo 'agent-theme-preview: Liberation Sans fonts are required for picker tiles' >&2
    exit 2
  }
  local work
  work=$(mktemp -d /tmp/agent-theme-preview-picker-XXXXXX)
  trap 'rm -rf "$work"' RETURN

  local -a closeup=("$closeup_image")
  [[ -z $closeup_crop ]] || closeup+=( -crop "$closeup_crop" +repage )
  closeup+=( -resize '196x196^' -gravity center -extent 196x196 -bordercolor "$selection" -border 6 )
  magick -size 1920x260 "xc:${background}" \
    \( "${closeup[@]}" \) -gravity northwest -geometry +124+26 -composite \
    -fill "$foreground" -font "$bold" -pointsize 56 -annotate +364+20 "$title" \
    -fill "$dark_foreground" -font "$regular" -pointsize 28 -annotate +366+90 "$subtitle" \
    \( "${chips[@]}" -background "$background" -splice 14x0 +append -chop 14x0 \) \
    -gravity northwest -geometry +364+136 -composite \
    \( -size 220x100 "xc:${foreground}" -fill "$background" -font "$bold" -pointsize 52 \
       -gravity center -annotate +0+0 Aa \) -gravity northwest -geometry +1302+136 -composite \
    "$work/band.png"
  magick "$top_image" -resize '1920x' -crop "1920x820+0+${top_offset}" +repage \
    -background black -gravity north -extent 1920x1080 "$work/band.png" \
    -gravity northwest -geometry +0+820 -composite \
    \( -size 1920x8 "xc:${accent}" \) -geometry +0+812 -composite \
    -colorspace sRGB -strip -define png:exclude-chunk=date,time \
    -define png:compression-level=9 -define png:compression-filter=5 -define png:compression-strategy=1 "PNG24:${output}"
  trap - RETURN
  rm -rf "$work"
  printf 'Rendered theme picker tile: %s\n' "$output"
}

case "${1:-}" in
  wallpaper) shift; render_wallpaper "$@" ;;
  palette) shift; render_palette "$@" ;;
  picker) shift; render_picker "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
