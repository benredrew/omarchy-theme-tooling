#!/usr/bin/env bash
# Validate a clean, reproducible Omarchy theme package before publication.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  agent-theme-package validate [--title "PALETTE TITLE"] <theme-repository>

Validates a theme-only repository and regenerates its standard previews from
colors.toml plus the ordered backgrounds/ images. A valid package must have
colors.toml, README.md, preview.png, one or more backgrounds, and the two
standard preview assets under previews/.
EOF
}

# The README follows docs/theme-readme.md: a # title, then exactly these ##
# sections in order, plus the hero image and both preview boards. Headings
# inside code fences are ignored.
check_readme() {
  local readme="$1" expected='Install|Backgrounds|Previews|Photo|License' found title asset
  title=$(awk '/^```/ { fence = !fence; next } !fence && /^# / { print; exit }' "$readme")
  [[ -n $title ]] || { echo 'agent-theme-package: README.md needs a "# Theme Name" title (see docs/theme-readme.md)' >&2; exit 1; }
  found=$(awk '/^```/ { fence = !fence; next } !fence && /^## / { sub(/^## /, ""); printf "%s%s", sep, $0; sep = "|" }' "$readme")
  [[ $found == "$expected" ]] || {
    echo "agent-theme-package: README.md sections must be ${expected//|/, } in that order; found: ${found//|/, }" >&2
    exit 1
  }
  for asset in '](preview.png)' 'previews/filter-intensity.png' 'previews/palette.png'; do
    grep -qF -- "$asset" "$readme" || {
      echo "agent-theme-package: README.md must include '$asset' (see docs/theme-readme.md)" >&2
      exit 1
    }
  done
}

# Every key in colors.toml must be one Omarchy reads: a name used by its theme
# templates or by omarchy-theme-color. The list comes from the installed
# Omarchy, so it follows Omarchy updates; without one, the check is skipped.
# Previews are compared by pixels, not bytes, so a preview written with an
# older encoder setting (e.g. uncompressed) still matches its regeneration.
same_pixels() {
  [[ $(magick identify -format '%wx%h' "$1" 2>/dev/null) == $(magick identify -format '%wx%h' "$2") ]] || return 1
  [[ $(magick compare -metric AE "$1" "$2" null: 2>&1 | cut -d ' ' -f 1) == 0 ]]
}

check_palette_keys() {
  local colors="$1" omarchy="${OMARCHY_PATH:-/usr/share/omarchy}" known unknown
  if [[ ! -d $omarchy/default/themed || ! -f $omarchy/bin/omarchy-theme-color ]]; then
    echo "agent-theme-package: no Omarchy at $omarchy; skipping the colors.toml key check" >&2
    return 0
  fi
  known=$({
    grep -rhoE '\{\{[^}]*\}\}' "$omarchy"/default/themed/*.tpl | grep -oE '[a-z_][a-z0-9_]*'
    grep -hoE 'THEME_COLORS\[[a-z_0-9]+\]' "$omarchy/bin/omarchy-theme-color" | sed -E 's/THEME_COLORS\[|\]//g'
    echo mode
  } | sort -u)
  unknown=$(sed -nE 's/^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\1/p' "$colors" | sort -u | comm -23 - <(printf '%s\n' "$known"))
  [[ -z $unknown ]] || {
    echo "agent-theme-package: colors.toml has keys Omarchy never reads: $(echo $unknown | tr ' ' ',' | sed 's/,/, /g')" >&2
    exit 1
  }
}

validate() {
  local title='OMARCHY PALETTE'
  if [[ ${1:-} == --title ]]; then
    title="${2:?agent-theme-package: --title needs text}"
    shift 2
  fi
  (( $# == 1 )) || { usage >&2; exit 2; }
  local repo="$1"
  [[ -d $repo ]] || { echo "agent-theme-package: not a directory: $repo" >&2; exit 2; }
  repo=$(realpath "$repo")

  local -a required=(colors.toml README.md preview.png previews/filter-intensity.png previews/palette.png)
  local path
  for path in "${required[@]}"; do
    [[ -f $repo/$path ]] || { echo "agent-theme-package: missing required asset: $path" >&2; exit 1; }
  done
  [[ -d $repo/backgrounds ]] || { echo 'agent-theme-package: missing backgrounds/' >&2; exit 1; }

  local preview_width
  preview_width=$(magick identify -format '%w' "$repo/preview.png")
  (( preview_width >= 1000 )) || { echo 'agent-theme-package: preview.png must be at least 1000px wide' >&2; exit 1; }

  local -a forbidden=(tools scripts bin node_modules .venv)
  for path in "${forbidden[@]}"; do
    [[ ! -e $repo/$path ]] || {
      echo "agent-theme-package: theme repositories contain installable theme assets, not tooling ($path found)" >&2
      exit 1
    }
  done

  [[ -f $repo/LICENSE ]] || { echo 'agent-theme-package: missing LICENSE (the author chooses the license)' >&2; exit 1; }
  check_readme "$repo/README.md"
  check_palette_keys "$repo/colors.toml"

  local -a levels=()
  mapfile -t levels < <(find "$repo/backgrounds" -maxdepth 1 -type f -printf '%f\n' | sort | while read -r filename; do
    case "$filename" in
      *.png|*.jpg|*.jpeg|*.webp) printf '%s\n' "$repo/backgrounds/$filename" ;;
    esac
  done)
  # One wallpaper or any number of ordered filter levels; agent-theme-preview
  # rejects a count too high for the image width.
  (( ${#levels[@]} >= 1 )) || {
    echo 'agent-theme-package: backgrounds/ must hold at least one image' >&2
    exit 1
  }

  local work
  work=$(mktemp -d /tmp/agent-theme-package-XXXXXX)
  trap 'rm -rf "$work"' RETURN
  agent-theme-preview wallpaper --gap 26 "$repo/colors.toml" "$work/filter-intensity.png" "${levels[@]}" >/dev/null
  agent-theme-preview palette --title "$title" "$repo/colors.toml" "$work/palette.png" >/dev/null
  same_pixels "$repo/previews/filter-intensity.png" "$work/filter-intensity.png" || {
    echo 'agent-theme-package: previews/filter-intensity.png is stale; regenerate it with agent-theme-preview' >&2
    exit 1
  }
  same_pixels "$repo/previews/palette.png" "$work/palette.png" || {
    echo 'agent-theme-package: previews/palette.png is stale; regenerate it with agent-theme-preview' >&2
    exit 1
  }
  trap - RETURN
  rm -rf "$work"
  printf 'Theme package valid and previews are pixel-identical: %s\n' "$repo"
}

case "${1:-}" in
  validate) shift; validate "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
