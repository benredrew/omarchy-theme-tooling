#!/usr/bin/env bash
# Deterministically turn one wallpaper into an ordered, non-destructive lo-fi spectrum.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  agent-theme-lofi [--levels N] [--tint #RRGGBB | --colors colors.toml] <source-image> <output-directory>

Creates N same-framing PNG copies (default 4) without modifying the source
image, evenly spaced from a faithful baseline to the strongest treatment:
  A-crisp.png       faithful baseline
  B-lofi.png        restrained softening and tonal compression
  C-heavy-lofi.png  clearly stylized and muted
  D-ultra-lofi.png  dreamy maximum treatment while retaining legibility

Those four are the reference points of one strength scale. Other counts sample
the same scale evenly: the first level is always crisp, the last (when N > 1)
always ultra-lofi, and the default 4 reproduces exactly the files above. A
level between reference points is named after the nearest one and suffixed
with its strength in percent, e.g. B-lofi-17.png. Letters stay sortable: past
26 levels every name uses two letters (AA, AB, ...).

--tint uses a theme-led color wash. --colors reads the `accent` value from an
Omarchy colors.toml. Without either option, the neutral dusk tint #9A5B58 is
used. The output directory must be empty (or not exist), preventing accidental
replacement of a prior spectrum.
EOF
}

need_image() {
  [[ -f $1 ]] || { echo "agent-theme-lofi: missing image: $1" >&2; exit 2; }
  [[ $(file --brief --mime-type -- "$1") == image/* ]] || {
    echo "agent-theme-lofi: not an image: $1" >&2
    exit 2
  }
}

toml_color() {
  local key="$1" colors="$2" value
  value=$(sed -nE "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\\\"(#[0-9A-Fa-f]{6})\\\"[[:space:]]*(#.*)?$/\\1/p" "$colors" | head -n 1)
  [[ -n $value ]] || { echo "agent-theme-lofi: colors.toml lacks '$key'" >&2; exit 2; }
  printf '%s\n' "$value"
}

# Sortable letter prefix for level i (0-based) of n: A..Z, or AA.. past 26.
level_letters() {
  local i="$1" n="$2" alphabet=ABCDEFGHIJKLMNOPQRSTUVWXYZ
  if (( n <= 26 )); then
    printf '%s' "${alphabet:i:1}"
  else
    printf '%s%s' "${alphabet:i / 26:1}" "${alphabet:i % 26:1}"
  fi
}

# Treatment for level i of n, interpolated piecewise-linearly through the four
# reference levels at strength 0, 1/3, 2/3 and 1. Positions are computed in
# integers so a level that lands on a reference point gets its exact values.
# Prints: brightness saturation shadow-lift contrast haze blur tint label
level_treatment() {
  awk -v i="$1" -v n="$2" 'BEGIN {
    split("100 96 92 88", bright); split("100 86 70 56", sat)
    split("0 1 3 5", lift);        split("0 -7 -15 -22", contrast)
    split("0 1.2 2.8 4.5", haze);  split("0 0.22 0.55 1.05", blur)
    split("0 3 8 14", tint);       split("crisp lofi heavy-lofi ultra-lofi", name)
    span = (n > 1) ? n - 1 : 1
    seg = int(3 * i / span); rem = (3 * i) % span; frac = rem / span
    if (seg >= 3) { seg = 3; frac = 0 }
    s = seg + 1
    label = name[s + (frac > 0.5 ? 1 : 0)]
    if (i > 0 && label == "crisp") label = "lofi"   # crisp means untreated
    if (rem != 0) label = sprintf("%s-%d", label, int(100 * i / span + 0.5))
    printf "%s %s %s %s %s %s %s %s\n", v(bright), v(sat), v(lift), v(contrast), v(haze), v(blur), v(tint), label
  }
  function v(p) { return frac == 0 ? p[s] : sprintf("%.4g", p[s] + frac * (p[s + 1] - p[s])) }'
}

main() {
  local tint='#9A5B58' tint_given=0 colors='' levels=4
  while (( $# > 0 )); do
    case "$1" in
      --levels)
        levels="${2:?agent-theme-lofi: --levels needs a count}"
        shift 2
        ;;
      --tint)
        tint="${2:?agent-theme-lofi: --tint needs #RRGGBB}"
        tint_given=1
        shift 2
        ;;
      --colors)
        colors="${2:?agent-theme-lofi: --colors needs colors.toml}"
        shift 2
        ;;
      -h|--help|help)
        usage
        return 0
        ;;
      *) break ;;
    esac
  done
  (( $# == 2 )) || { usage >&2; exit 2; }
  [[ $levels =~ ^[1-9][0-9]*$ ]] || { echo 'agent-theme-lofi: --levels must be a whole number of at least 1' >&2; exit 2; }
  (( levels <= 676 )) || { echo 'agent-theme-lofi: --levels is limited to 676 (two letters)' >&2; exit 2; }
  [[ $tint =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo 'agent-theme-lofi: tint must be #RRGGBB' >&2; exit 2; }
  [[ -z $colors || -f $colors ]] || { echo "agent-theme-lofi: missing colors file: $colors" >&2; exit 2; }
  [[ -z $colors ]] || (( ! tint_given )) || {
    echo 'agent-theme-lofi: choose either --tint or --colors, not both' >&2
    exit 2
  }
  [[ -n $colors ]] && tint=$(toml_color accent "$colors")

  local source="$1" output_dir="$2"
  need_image "$source"
  if [[ -e $output_dir ]] && [[ -n $(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    echo "agent-theme-lofi: output directory is not empty: $output_dir" >&2
    exit 2
  fi
  mkdir -p "$output_dir"

  local source_frame="${source}[0]"
  local -a stable_png=(-colorspace sRGB -strip -define png:exclude-chunk=date,time -define png:compression-level=0)

  # The treatment intentionally increases along the same four dimensions:
  # lower saturation/local contrast, lighter shadows, softened micro-detail,
  # then a restrained theme-color wash. Geometry and framing never change.
  local i out bright sat lift contrast haze blur strength label
  for ((i = 0; i < levels; i++)); do
    read -r bright sat lift contrast haze blur strength label < <(level_treatment "$i" "$levels")
    out="$output_dir/$(level_letters "$i" "$levels")-$label.png"
    if (( i == 0 )); then
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" "${stable_png[@]}" "PNG24:$out"
    else
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" -modulate "$bright,$sat,100" \
        -brightness-contrast "$lift,$contrast" -evaluate Add "$haze%" -blur "0x$blur" \
        -fill "$tint" -colorize "$strength" "${stable_png[@]}" "PNG24:$out"
    fi
  done

  printf 'Created %d-level lo-fi spectrum in %s using tint %s\n' "$levels" "$output_dir" "$tint"
}

main "$@"
