#!/usr/bin/env bash
# Deterministically turn one wallpaper into an ordered, non-destructive treatment spectrum.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  agent-theme-lofi [--method NAME] [--levels N] [--tint #RRGGBB | --colors colors.toml]
                   <source-image> <output-directory>

Creates N same-framing PNG copies (default 4) without modifying the source
image, evenly spaced from a faithful baseline to the method's strongest
treatment:
  A-crisp.png       faithful baseline
  B-lofi.png        first reference strength
  C-heavy-lofi.png  second reference strength
  D-ultra-lofi.png  strongest treatment, still legible

Methods (more may be added; each maps the same 0–1 strength scale):
  soft-tint        (default) softening, tonal compression, muted color and a
                   restrained tint wash
  low-res-speckle  lower resolution with hard-edged pixels, fewer colors with
                   dithering, monochrome grain and lifted blacks; its strongest
                   level is drawn only from the theme's own colors (needs
                   --colors; with --tint only it quantizes to 12 image colors)

The four files above are each method's reference points. Other counts sample
the same scale evenly: the first level is always crisp, the last (when N > 1)
always the strongest, and the default 4 reproduces exactly the files above. A
level between reference points is named after the nearest one and suffixed
with its strength in percent, e.g. B-lofi-17.png. Letters stay sortable: past
26 levels every name uses two letters (AA, AB, ...).

--tint sets soft-tint's color wash. --colors reads `accent` (the wash) and,
for low-res-speckle, the theme palette from an Omarchy colors.toml. Without
either, the neutral dusk tint #9A5B58 is used. The output directory must be
empty (or not exist), preventing accidental replacement of a prior spectrum.
EOF
}

need_image() {
  [[ -f $1 ]] || { echo "agent-theme-lofi: missing image: $1" >&2; exit 2; }
  [[ $(file --brief --mime-type -- "$1") == image/* ]] || {
    echo "agent-theme-lofi: not an image: $1" >&2
    exit 2
  }
}

toml_color() {
  local key="$1" colors="$2" value
  value=$(sed -nE "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\\\"(#[0-9A-Fa-f]{6})\\\"[[:space:]]*(#.*)?$/\\1/p" "$colors" | head -n 1)
  [[ -n $value ]] || { echo "agent-theme-lofi: colors.toml lacks '$key'" >&2; exit 2; }
  printf '%s\n' "$value"
}

# Sortable letter prefix for level i (0-based) of n: A..Z, or AA.. past 26.
level_letters() {
  local i="$1" n="$2" alphabet=ABCDEFGHIJKLMNOPQRSTUVWXYZ
  if (( n <= 26 )); then
    printf '%s' "${alphabet:i:1}"
  else
    printf '%s%s' "${alphabet:i / 26:1}" "${alphabet:i % 26:1}"
  fi
}

# Settings for level i of n under a method, interpolated piecewise-linearly
# through the method's four reference levels at strength 0, 1/3, 2/3 and 1.
# Positions are computed in integers so a level that lands on a reference
# point gets its exact values. Prints the method's settings, then the label.
level_treatment() {
  awk -v method="$1" -v i="$2" -v n="$3" 'BEGIN {
    split("crisp lofi heavy-lofi ultra-lofi", name)
    if (method == "soft-tint") {
      k = 7
      split("100 96 92 88", p1); split("100 86 70 56", p2)    # brightness, saturation
      split("0 1 3 5", p3);      split("0 -7 -15 -22", p4)    # shadow lift, contrast
      split("0 1.2 2.8 4.5", p5); split("0 0.22 0.55 1.05", p6) # haze, blur
      split("0 3 8 14", p7)                                   # tint strength
    } else {
      k = 4
      split("1 3 5 8", p1)       # pixel size (source pixels per output pixel)
      split("256 48 16 12", p2)  # color count; the strongest level uses the theme palette
      split("0 0.5 0.8 1.0", p3) # grain
      split("0 4 7 10", p4)      # black lift (%)
    }
    span = (n > 1) ? n - 1 : 1
    seg = int(3 * i / span); rem = (3 * i) % span; frac = rem / span
    if (seg >= 3) { seg = 3; frac = 0 }
    s = seg + 1
    label = name[s + (frac > 0.5 ? 1 : 0)]
    if (i > 0 && label == "crisp") label = "lofi"   # crisp means untreated
    if (rem != 0) label = sprintf("%s-%d", label, int(100 * i / span + 0.5))
    out = ""
    for (j = 1; j <= k; j++) out = out v(j) " "
    print out label
  }
  function v(j,   a, b) {
    a = (j == 1) ? p1[s] : (j == 2) ? p2[s] : (j == 3) ? p3[s] : (j == 4) ? p4[s] : (j == 5) ? p5[s] : (j == 6) ? p6[s] : p7[s]
    if (frac == 0) return a
    b = (j == 1) ? p1[s+1] : (j == 2) ? p2[s+1] : (j == 3) ? p3[s+1] : (j == 4) ? p4[s+1] : (j == 5) ? p5[s+1] : (j == 6) ? p6[s+1] : p7[s+1]
    return sprintf("%.4g", a + frac * (b - a))
  }'
}

main() {
  local tint='#9A5B58' tint_given=0 colors='' levels=4 method='soft-tint'
  while (( $# > 0 )); do
    case "$1" in
      --method)
        method="${2:?agent-theme-lofi: --method needs a name}"
        shift 2
        ;;
      --levels)
        levels="${2:?agent-theme-lofi: --levels needs a count}"
        shift 2
        ;;
      --tint)
        tint="${2:?agent-theme-lofi: --tint needs #RRGGBB}"
        tint_given=1
        shift 2
        ;;
      --colors)
        colors="${2:?agent-theme-lofi: --colors needs colors.toml}"
        shift 2
        ;;
      -h|--help|help)
        usage
        return 0
        ;;
      *) break ;;
    esac
  done
  (( $# == 2 )) || { usage >&2; exit 2; }
  [[ $method == soft-tint || $method == low-res-speckle ]] || {
    echo "agent-theme-lofi: unknown method '$method' (soft-tint, low-res-speckle)" >&2
    exit 2
  }
  [[ $levels =~ ^[1-9][0-9]*$ ]] || { echo 'agent-theme-lofi: --levels must be a whole number of at least 1' >&2; exit 2; }
  (( levels <= 676 )) || { echo 'agent-theme-lofi: --levels is limited to 676 (two letters)' >&2; exit 2; }
  [[ $tint =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo 'agent-theme-lofi: tint must be #RRGGBB' >&2; exit 2; }
  [[ -z $colors || -f $colors ]] || { echo "agent-theme-lofi: missing colors file: $colors" >&2; exit 2; }
  [[ -z $colors ]] || (( ! tint_given )) || {
    echo 'agent-theme-lofi: choose either --tint or --colors, not both' >&2
    exit 2
  }
  [[ -n $colors ]] && tint=$(toml_color accent "$colors")

  local source="$1" output_dir="$2"
  need_image "$source"
  if [[ -e $output_dir ]] && [[ -n $(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    echo "agent-theme-lofi: output directory is not empty: $output_dir" >&2
    exit 2
  fi
  mkdir -p "$output_dir"

  local source_frame="${source}[0]"
  local -a stable_png=(-colorspace sRGB -strip -define png:exclude-chunk=date,time -define png:compression-level=0)
  local width height
  read -r width height < <(magick identify -format '%w %h\n' "$source_frame")

  # low-res-speckle's strongest level is drawn only from the theme colors a
  # photo can plausibly contain: surfaces, inks, accent, and the earthy hues.
  # Reds, blues and magentas are left out because dithering borrows them to
  # approximate neutrals, which scatters colored confetti across the image.
  local work=''
  if [[ $method == low-res-speckle && -n $colors ]]; then
    work=$(mktemp -d /tmp/agent-theme-lofi-XXXXXX)
    trap "rm -rf -- '$work'" EXIT
    local key
    local -a swatches=()
    for key in background dark_background darker_background foreground light_foreground dark_foreground \
      accent selection muted yellow green brown bright_green bright_yellow; do
      swatches+=("xc:$(toml_color "$key" "$colors")")
    done
    magick "${swatches[@]}" +append -unique-colors "$work/palette.png"
  fi

  local i out label
  local -a s
  for ((i = 0; i < levels; i++)); do
    read -r -a s < <(level_treatment "$method" "$i" "$levels")
    label="${s[-1]}"
    out="$output_dir/$(level_letters "$i" "$levels")-$label.png"
    if (( i == 0 )); then
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" "${stable_png[@]}" "PNG24:$out"
    elif [[ $method == soft-tint ]]; then
      # Increases along the same four dimensions: lower saturation/local
      # contrast, lighter shadows, softened micro-detail, then a restrained
      # theme-color wash. Geometry and framing never change.
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" -modulate "${s[0]},${s[1]},100" \
        -brightness-contrast "${s[2]},${s[3]}" -evaluate Add "${s[4]}%" -blur "0x${s[5]}" \
        -fill "$tint" -colorize "${s[6]}" "${stable_png[@]}" "PNG24:$out"
    else
      # Work at reduced resolution so grain and dither land on the coarse
      # pixel grid, then scale back up with nearest-neighbour sampling.
      local pixel lift small_w small_h last=$((i == levels - 1))
      local -a quantize
      pixel=$(printf '%.0f' "${s[0]}"); (( pixel >= 1 )) || pixel=1
      small_w=$(( (width + pixel - 1) / pixel )); small_h=$(( (height + pixel - 1) / pixel ))
      lift=$(printf '%.0f' "${s[3]}")
      if (( last )) && [[ -n $work ]]; then
        quantize=(-dither FloydSteinberg -remap "$work/palette.png")
      else
        quantize=(-dither FloydSteinberg -colors "$(printf '%.0f' "${s[1]}")")
      fi
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" -resize "${small_w}x${small_h}!" \
        +level "${lift}%,$((100 - lift / 2))%" \
        \( +clone -fill gray50 -colorize 100 -seed 7 -attenuate "${s[2]}" +noise Gaussian -colorspace gray \) \
        -compose overlay -composite "${quantize[@]}" \
        -sample "${width}x${height}!" "${stable_png[@]}" "PNG24:$out"
    fi
  done

  printf 'Created %d-level %s spectrum in %s\n' "$levels" "$method" "$output_dir"
}

main "$@"
