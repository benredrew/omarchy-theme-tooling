#!/usr/bin/env bash
# Deterministically turn one wallpaper into an ordered, non-destructive treatment spectrum.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  agent-theme-levels [--method NAME] [--levels N] [--tint #RRGGBB | --colors colors.toml]
                     <source-image> <output-directory>

Creates N same-framing PNG copies (default 4) without modifying the source
image, evenly spaced from a faithful baseline to the method's strongest
treatment:
  A-crisp.png       faithful baseline
  B-light.png       first reference strength
  C-medium.png      second reference strength
  D-strong.png      strongest treatment, still legible

Methods (more may be added; each maps the same 0–1 strength scale):
  soft-tint        (default) softening, tonal compression, muted color and a
                   restrained tint wash
  low-res-speckle  hard-edged pixels, each the true local average of the image
                   under it, then fewer colors with half-strength dithering,
                   light monochrome grain and slightly lifted blacks; its
                   strongest level is drawn only from the theme's own colors
                   (needs --colors; with --tint only it quantizes to 12 image
                   colors)
  low-res-painting edge-preserving flattening into painted shapes at lower
                   resolution, a few flat undithered colors, lifted pastel
                   light with a warm wash, soft glow and gentle grain: a
                   lo-fi-beats illustration look

The four files above are each method's reference points. Other counts sample
the same scale evenly: the first level is always crisp, the last (when N > 1)
always the strongest, and the default 4 reproduces exactly the files above. A
level between reference points is named after the nearest one and suffixed
with its strength in percent, e.g. B-light-17.png. Letters stay sortable: past
26 levels every name uses two letters (AA, AB, ...).

--tint sets the color wash (soft-tint, low-res-painting). --colors reads it
from an Omarchy colors.toml instead: `accent` for soft-tint, the pale
`selection` color for low-res-painting, plus the theme palette for
low-res-speckle. Without either, the neutral dusk tint #9A5B58 is used. The output directory must be
empty (or not exist), preventing accidental replacement of a prior spectrum.
EOF
}

need_image() {
  [[ -f $1 ]] || { echo "agent-theme-levels: missing image: $1" >&2; exit 2; }
  [[ $(file --brief --mime-type -- "$1") == image/* ]] || {
    echo "agent-theme-levels: not an image: $1" >&2
    exit 2
  }
}

toml_color() {
  local key="$1" colors="$2" value
  value=$(sed -nE "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\\\"(#[0-9A-Fa-f]{6})\\\"[[:space:]]*(#.*)?$/\\1/p" "$colors" | head -n 1)
  [[ -n $value ]] || { echo "agent-theme-levels: colors.toml lacks '$key'" >&2; exit 2; }
  printf '%s\n' "$value"
}

# Sortable letter prefix for level i (0-based) of n: A..Z, or AA.. past 26.
level_letters() {
  local i="$1" n="$2" alphabet=ABCDEFGHIJKLMNOPQRSTUVWXYZ
  if (( n <= 26 )); then
    printf '%s' "${alphabet:i:1}"
  else
    printf '%s%s' "${alphabet:i / 26:1}" "${alphabet:i % 26:1}"
  fi
}

# Settings for level i of n under a method, interpolated piecewise-linearly
# through the method's four reference levels at strength 0, 1/3, 2/3 and 1.
# Positions are computed in integers so a level that lands on a reference
# point gets its exact values. Prints the method's settings, then the label.
level_treatment() {
  awk -v method="$1" -v i="$2" -v n="$3" 'BEGIN {
    split("crisp light medium strong", name)
    # One row per setting: its values at strength 0, 1/3, 2/3 and 1.
    if (method == "soft-tint") {
      row("100 96 92 88"); row("100 86 70 56")      # brightness, saturation
      row("0 1 3 5"); row("0 -7 -15 -22")           # shadow lift, contrast
      row("0 1.2 2.8 4.5"); row("0 0.22 0.55 1.05") # haze, blur
      row("0 3 8 14")                               # tint strength
    } else if (method == "low-res-speckle") {
      row("1 4 8 12")          # pixel size (source pixels per output pixel)
      row("512 64 24 12")      # color count; the strongest level uses the theme palette
      row("0 0.325 0.5 0.65")  # grain
      row("0 2.75 5 7.25")     # black lift (%)
    } else {
      row("1 2 3 4")         # painting scale (source pixels per painted pixel)
      row("0 2 3 4")         # kuwahara radius at painting scale
      row("256 28 16 10")    # flat colors, undithered
      row("1 1.2 1.4 1.6")   # gamma
      row("0 5 10 14")       # black lift (%)
      row("100 103 105 106") # brightness
      row("100 108 115 120") # saturation
      row("100 97 95 94")    # hue (toward warm yellow-green)
      row("0 5 9 12")        # warm wash strength
      row("0 15 25 35")      # glow blend
      row("0 0.2 0.3 0.35")  # grain
    }
    span = (n > 1) ? n - 1 : 1
    seg = int(3 * i / span); rem = (3 * i) % span; frac = rem / span
    if (seg >= 3) { seg = 3; frac = 0 }
    s = seg + 1
    label = name[s + (frac > 0.5 ? 1 : 0)]
    if (i > 0 && label == "crisp") label = "light"   # crisp means untreated
    if (rem != 0) label = sprintf("%s-%d", label, int(100 * i / span + 0.5))
    out = ""
    for (j = 1; j <= k; j++) out = out v(j) " "
    print out label
  }
  function row(values,   t, x) { k++; split(values, t); for (x = 1; x <= 4; x++) P[k, x] = t[x] }
  function v(j) {
    if (frac == 0) return P[j, s]
    return sprintf("%.4g", P[j, s] + frac * (P[j, s + 1] - P[j, s]))
  }'
}

main() {
  local tint='#9A5B58' tint_given=0 colors='' levels=4 method='soft-tint'
  while (( $# > 0 )); do
    case "$1" in
      --method)
        method="${2:?agent-theme-levels: --method needs a name}"
        shift 2
        ;;
      --levels)
        levels="${2:?agent-theme-levels: --levels needs a count}"
        shift 2
        ;;
      --tint)
        tint="${2:?agent-theme-levels: --tint needs #RRGGBB}"
        tint_given=1
        shift 2
        ;;
      --colors)
        colors="${2:?agent-theme-levels: --colors needs colors.toml}"
        shift 2
        ;;
      -h|--help|help)
        usage
        return 0
        ;;
      *) break ;;
    esac
  done
  (( $# == 2 )) || { usage >&2; exit 2; }
  [[ $method == soft-tint || $method == low-res-speckle || $method == low-res-painting ]] || {
    echo "agent-theme-levels: unknown method '$method' (soft-tint, low-res-speckle, low-res-painting)" >&2
    exit 2
  }
  [[ $levels =~ ^[1-9][0-9]*$ ]] || { echo 'agent-theme-levels: --levels must be a whole number of at least 1' >&2; exit 2; }
  (( levels <= 676 )) || { echo 'agent-theme-levels: --levels is limited to 676 (two letters)' >&2; exit 2; }
  [[ $tint =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo 'agent-theme-levels: tint must be #RRGGBB' >&2; exit 2; }
  [[ -z $colors || -f $colors ]] || { echo "agent-theme-levels: missing colors file: $colors" >&2; exit 2; }
  [[ -z $colors ]] || (( ! tint_given )) || {
    echo 'agent-theme-levels: choose either --tint or --colors, not both' >&2
    exit 2
  }
  local wash="$tint"
  if [[ -n $colors ]]; then
    tint=$(toml_color accent "$colors")
    wash=$(toml_color selection "$colors")
  fi

  local source="$1" output_dir="$2"
  need_image "$source"
  if [[ -e $output_dir ]] && [[ -n $(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    echo "agent-theme-levels: output directory is not empty: $output_dir" >&2
    exit 2
  fi
  mkdir -p "$output_dir"

  local source_frame="${source}[0]"
  local -a stable_png=(-colorspace sRGB -strip -define png:exclude-chunk=date,time
    -define png:compression-level=9 -define png:compression-filter=5 -define png:compression-strategy=1)
  local width height
  read -r width height < <(magick identify -format '%w %h\n' "$source_frame")

  # low-res-speckle's strongest level is drawn only from the theme colors a
  # photo can plausibly contain: surfaces, inks, accent, and the earthy hues.
  # Reds, blues and magentas are left out because dithering borrows them to
  # approximate neutrals, which scatters colored confetti across the image.
  local work=''
  if [[ $method == low-res-speckle && -n $colors ]]; then
    work=$(mktemp -d /tmp/agent-theme-levels-XXXXXX)
    trap "rm -rf -- '$work'" EXIT
    local key
    local -a swatches=()
    for key in background dark_background darker_background foreground light_foreground dark_foreground \
      accent selection muted yellow green brown bright_green bright_yellow; do
      swatches+=("xc:$(toml_color "$key" "$colors")")
    done
    magick "${swatches[@]}" +append -unique-colors "$work/palette.png"
  fi

  local i out label
  local -a s
  for ((i = 0; i < levels; i++)); do
    read -r -a s < <(level_treatment "$method" "$i" "$levels")
    label="${s[-1]}"
    out="$output_dir/$(level_letters "$i" "$levels")-$label.png"
    if (( i == 0 )); then
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" "${stable_png[@]}" "PNG24:$out"
    elif [[ $method == soft-tint ]]; then
      # Increases along the same four dimensions: lower saturation/local
      # contrast, lighter shadows, softened micro-detail, then a restrained
      # theme-color wash. Geometry and framing never change.
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" -modulate "${s[0]},${s[1]},100" \
        -brightness-contrast "${s[2]},${s[3]}" -evaluate Add "${s[4]}%" -blur "0x${s[5]}" \
        -fill "$tint" -colorize "${s[6]}" "${stable_png[@]}" "PNG24:$out"
    elif [[ $method == low-res-painting ]]; then
      # Flatten into painted shapes at reduced resolution, grade toward warm
      # pastel light, then quantize at full size without dithering so color
      # bands stay clean, softened edges and a glow on top. Edge softening and
      # glow scale with width (1.2px and 24px at 3840px).
      local scale small_w small_h edge glow
      scale=$(printf '%.0f' "${s[0]}"); (( scale >= 1 )) || scale=1
      small_w=$(( (width + scale / 2) / scale )); small_h=$(( (height + scale / 2) / scale ))
      read -r edge glow < <(awk -v w="$width" 'BEGIN { printf "%.4g %.4g\n", 1.2 * w / 3840, 24 * w / 3840 }')
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" -resize "${small_w}x${small_h}!" -kuwahara "${s[1]}" \
        -gamma "${s[3]}" +level "${s[4]}%,100%" -modulate "${s[5]},${s[6]},${s[7]}" -fill "$wash" -colorize "${s[8]}" \
        -resize "${width}x${height}!" -dither None -colors "$(printf '%.0f' "${s[2]}")" -blur "0x$edge" \
        \( +clone -blur "0x$glow" \) -compose blend -define compose:args="${s[9]}" -composite \
        \( +clone -fill gray50 -colorize 100 -seed 7 -attenuate "${s[10]}" +noise Gaussian -colorspace gray \) \
        -compose overlay -composite "${stable_png[@]}" "PNG24:$out"
    else
      # Average each pixel block in linear light so it keeps the image's local
      # color, then grain and a half-strength dither on that coarse grid (a
      # full-strength dither scatters confetti), and scale back up with
      # nearest-neighbour sampling.
      local pixel lift small_w small_h last=$((i == levels - 1))
      local -a quantize
      pixel=$(printf '%.0f' "${s[0]}"); (( pixel >= 1 )) || pixel=1
      small_w=$(( (width + pixel - 1) / pixel )); small_h=$(( (height + pixel - 1) / pixel ))
      lift=$(printf '%.0f' "${s[3]}")
      if (( last )) && [[ -n $work ]]; then
        quantize=(-dither FloydSteinberg -define dither:diffusion-amount=50% -remap "$work/palette.png")
      else
        quantize=(-dither FloydSteinberg -define dither:diffusion-amount=50% -colors "$(printf '%.0f' "${s[1]}")")
      fi
      MAGICK_THREAD_LIMIT=1 magick "$source_frame" -colorspace RGB -scale "${small_w}x${small_h}!" -colorspace sRGB \
        +level "${lift}%,$((100 - lift / 2))%" \
        \( +clone -fill gray50 -colorize 100 -seed 7 -attenuate "${s[2]}" +noise Gaussian -colorspace gray \) \
        -compose overlay -composite "${quantize[@]}" \
        -sample "${width}x${height}!" "${stable_png[@]}" "PNG24:$out"
    fi
  done

  printf 'Created %d-level %s spectrum in %s\n' "$levels" "$method" "$output_dir"
}

main "$@"
